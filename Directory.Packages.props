<Project>
  <ItemGroup>
    <!--
      MinVer derives the version from the git tag (see Directory.Build.props). Build-time only:
      Directory.Build.props references it with PrivateAssets="all", so it appears in no nuspec.
    -->
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- Engineering icon generation only; MIT-licensed portable PNG codecs and native assets. -->
    <PackageVersion Include="SkiaSharp" Version="4.156.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    <!-- Independent JSON Schema validation in the wire-description tests only. -->
    <PackageVersion Include="JsonSchema.Net" Version="9.6.0" />

    <!-- Server requires the matching client patch; DevServer bundles its own Server library. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.1" />
    <!--
      A RANGE, NOT A POINT, AND IT IS THE ONE NUMBER CONSUMERS INHERIT. NuGet reads a bare
      `Version="11.0.0"` in a nuspec as ">= 11.0.0" with no ceiling, so the package would resolve
      against EF Core 12. This provider is built on EF internals by design (19 files carry
      `#pragma warning disable EF1001`), and a major EF release moves them, so an unbounded range
      trades a clear restore error for a runtime failure inside IStateManager.

      Npgsql declares the same shape: its 10.0.0 is [10.0.0, 11.0.0) and its 10.0.2 is
      [10.0.4, 11.0.0), the floor raised deliberately once it needed a later patch.

      THE FLOOR IS THE POINT OF THE LOWER BOUND. It is what a consumer is forced onto, so do not
      raise it to chase a patch; raise it only when this provider needs a fix that shipped in one.
      .github/dependabot.yml ignores this family for exactly that reason.

      MICROSOFT.ENTITYFRAMEWORKCORE.RELATIONAL IS THE SECOND NUMBER CONSUMERS INHERIT, and carries
      the same range for the same reason. InfoCarrier.Core has referenced it since R135
      (2026-09-03), and until 2026-09-28 it was a bare `10.0.1` here, so 10.1.x declared it with no
      ceiling beside an EF Core dependency that had one. The other EF packages below are test and
      sample references and reach no nuspec.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[11.0.0,12.0.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Proxies" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite.NetTopologySuite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[11.0.0,12.0.0)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Specification.Tests" Version="11.0.0" />
    <!-- EF Core 11 requires bundle 3.0.5. No backing-store dependency reaches shipped packages. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <!-- Tier C is test-only. The embedded engine needs no installation or server process. -->
    <PackageVersion Include="FirebirdSql.EntityFrameworkCore.Firebird" Version="14.0.0-rc1" />
    <PackageVersion Include="FirebirdDb.Embedded.V5.NativeAssets.Windows.X64" Version="2.0.6" />
    <PackageVersion Include="FirebirdDb.Embedded.V5.NativeAssets.Linux.X64" Version="2.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <!-- Keep repository transitive dependencies on .NET 11. Packable projects disable transitive pinning. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- Cryptography dependencies used by specification and design tooling. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Keep VSTest filters, TRX reports, and coverage collectors used by eng/ and CI. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!--
      TEST-ONLY, and it buys determinism rather than convenience. `FakeTimeProvider.Advance` fires
      every timer callback that has come due, SYNCHRONOUSLY on the calling thread, which is what
      lets the transaction-eviction tests assert a timeout without sleeping. Measured before it was
      added: one `Advance(50s)` over a 10s period fires six times, and `PeriodicTimer` built over
      the fake releases `WaitForNextTickAsync` on the same call.

      A HAND-ROLLED `TimeProvider` IS NOT A SUBSTITUTE, and the probe that established it is
      worth not repeating. Overriding `GetUtcNow()` alone leaves timers on the SYSTEM clock,
      because that is what the base `TimeProvider.CreateTimer` uses, so a test written against
      one passes only when the real period happens to elapse inside the assertion's wait. That is a
      test green by accident, which is the failure mode this repository treats as a defect.
    -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />

    <!-- Tier D is suspended until MongoDB supports EF Core 11. -->
  </ItemGroup>
</Project>
