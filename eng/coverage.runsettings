<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[InfoCarrier.Core]*,[InfoCarrier.Core.Abstractions]*,[InfoCarrier.Core.AspNetCore]*</Include>
          <Exclude>[InfoCarrier.Core.TestUtilities]*,[Northwind.*]*</Exclude>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
