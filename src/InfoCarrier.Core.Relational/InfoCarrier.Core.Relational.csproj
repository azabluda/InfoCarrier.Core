<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One sentence. nuget.org truncates a description on the search results page, and the reason
      this is a separate package is design rationale: it belongs in the comment below, not on a
      package listing. See docs/doc-style.md rule 5.
    -->
    <Description>Relational support for InfoCarrier.Core: reference it on both halves when the backing store is a relational database.</Description>
    <RootNamespace>InfoCarrier.Core.Relational</RootNamespace>
    <AssemblyName>InfoCarrier.Core.Relational</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- See the note in InfoCarrier.Core.csproj: a package declares what it references. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>

    <!--
      NO BASELINE TO VALIDATE AGAINST YET, and this was measured rather than assumed.
      `Directory.Build.props` turns package validation on for every packable project and names
      `PackageValidationBaselineVersion` 10.0.0, so adding a NEW shipped package makes the restore
      go looking for `InfoCarrier.Core.Relational 10.0.0` on nuget.org and fail with NU1101 before
      anything compiles. There is nothing to compare a first release with.

      TURN THIS BACK ON once this package has a published stable version, and raise the baseline
      with each release exactly as the other two do. Until then the promise this gate keeps does
      not exist for this package, so the gate has nothing to say.
    -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\assets\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!--
    THE WHOLE POINT OF THE PACKAGE IS THIS REFERENCE, and the reason it is here rather than in
    InfoCarrier.Core is `docs/architecture.md` §6a D3: the core package must stay usable against a
    backing store that is not relational. An application adds this one when its store is.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoCarrier.Core\InfoCarrier.Core.csproj" />
  </ItemGroup>

</Project>
