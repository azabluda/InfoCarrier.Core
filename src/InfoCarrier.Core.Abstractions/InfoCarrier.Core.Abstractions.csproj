<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Public contracts for InfoCarrier.Core — client/server/transport/serializer abstractions. DI-first testability seam.</Description>
    <RootNamespace>InfoCarrier.Core</RootNamespace>
    <AssemblyName>InfoCarrier.Core.Abstractions</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- See the note in InfoCarrier.Core.csproj: a package declares what it references. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\nuget-readme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

</Project>
