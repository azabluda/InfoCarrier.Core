<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One sentence. nuget.org truncates a description on the search results page, and the reason
      the endpoint is a separate package is design rationale: it belongs in the FrameworkReference
      comment below, not on a package listing. See docs/doc-style.md rule 5.
    -->
    <Description>ASP.NET Core server binding for InfoCarrier.Core: one endpoint that executes a client's queries and units of work against a real database.</Description>
    <RootNamespace>InfoCarrier.Core.AspNetCore</RootNamespace>
    <AssemblyName>InfoCarrier.Core.AspNetCore</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- See the note in InfoCarrier.Core.csproj: a package declares what it references. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\assets\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

  <!--
    A FrameworkReference, not a PackageReference. `Microsoft.AspNetCore.App` is a shared framework:
    referencing it this way adds no package dependency and no files to the output — the host
    already has it. This is the whole reason the endpoint is a separate package: fold it into
    InfoCarrier.Core and every client that only wants a DbContext would have to be an ASP.NET Core
    app to restore it.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoCarrier.Core\InfoCarrier.Core.csproj" />
  </ItemGroup>

</Project>
