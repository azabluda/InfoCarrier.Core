<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--
    TWO DELIBERATE REMOVALS SINCE 10.0.0-preview.1, both from commit 22977fa, which dropped a
    warning that nothing had raised since M4. Package validation found them on its first run,
    which is the whole argument for turning it on: nothing else had noticed.

    Both are safe to DELETE once the baseline in Directory.Build.props moves to 10.0.0, because
    the surface they refer to will no longer be in the baseline package. Do not add to this file
    without saying here why a break is intended.
  -->
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>F:InfoCarrier.Core.InfoCarrierEventId.TransactionIgnoredWarning</Target>
    <Left>lib/net10.0/InfoCarrier.Core.dll</Left>
    <Right>lib/net10.0/InfoCarrier.Core.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:InfoCarrier.Core.InfoCarrierLoggingDefinitions.LogTransactionsNotSupported(Microsoft.EntityFrameworkCore.Diagnostics.IDiagnosticsLogger)</Target>
    <Left>lib/net10.0/InfoCarrier.Core.dll</Left>
    <Right>lib/net10.0/InfoCarrier.Core.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>