<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tier D is suspended until MongoDB.EntityFrameworkCore supports EF Core 11.
       Keep its source for restoration. No EF Core 10 package graph is retained. -->
  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <Target Name="TierDSuspended" BeforeTargets="Build;VSTest">
    <Error Text="Tier D is suspended pending a MongoDB provider for EF Core 11. See docs/plans/v11/adoption-checklist.md." />
  </Target>
</Project>
