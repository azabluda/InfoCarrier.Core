<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR-009 Tier A: the spec suite run against a client whose backing store is EF's InMemory
    provider, plus this repository's own unit tests for the serializer and the projection split.

    NOTHING RELATIONAL IS REFERENCED HERE, and that is the point of the split. Not
    EFCore.Relational.Specification.Tests, not InfoCarrier.Core.Relational, not a relational
    provider. Tier A must not get a relational client: InMemory is not a relational store, and a
    relational client over it recreates the disagreement the seam exists to prevent
    (architecture.md section 6a, D3). This used to be a per-fixture flag, which asks politely.
    Tier B is InfoCarrier.Core.Relational.FunctionalTests.
  -->
  <PropertyGroup>
    <Description>Functional tests for InfoCarrier.Core against a non-relational backing store (ADR-009 Tier A, InMemory).</Description>
    <RootNamespace>InfoCarrier.Core.FunctionalTests</RootNamespace>
    <AssemblyName>InfoCarrier.Core.FunctionalTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Not a documented API, but the doc file is generated anyway: IDE0005 (unnecessary using) does
      not run without one. The doc-comment warnings that come with it (1254 in this repository) are
      switched off by the folder-scoped .editorconfig, not here.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CompiledModelTestBase compiles the model it scaffolds, in-process, against this assembly's
      own compilation references. Without this it cannot resolve `netstandard` and says so by
      name. Every EF test project that hosts this base sets it — InMemory, Sqlite, SqlServer,
      Cosmos and Design all do.
    -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The compiled-model baselines are *expected output*, not source: the same
      `TestNamespace.DbContextModel` is generated once per test, so compiling them gives 125
      duplicate-definition errors. EF's own InMemory and Sqlite test projects carry these two
      lines verbatim.
    -->
    <Compile Remove="InMemory\Scaffolding\Baselines\**\*" />
    <None Include="InMemory\Scaffolding\Baselines\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfoCarrier.Core\InfoCarrier.Core.csproj" />
    <ProjectReference Include="..\InfoCarrier.Core.TestUtilities\InfoCarrier.Core.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Specification.Tests" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
