<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE WHOLE SPEC SUITE, both ADR-009 tiers, plus this repository's own unit tests for the
    serializer and the projection split.

    ONE PROJECT SINCE R136, and it was two between R122 and R136. The split existed to keep
    anything relational off Tier A's compile line: while InfoCarrier.Core.Relational was a separate
    package, naming a relational type in the shared harness would have put that package on Tier A
    through a transitive reference, and a relational client over an InMemory backend was the
    disagreement the seam existed to prevent. Neither half of that reasoning survives. D3 is
    superseded (architecture.md section 6a, 2026-09-03), so InfoCarrier.Core carries the relational
    half and there is no second package to keep out; and since R135 every client registers the
    relational half unconditionally, so a relational client over an InMemory backend is not an
    accident to prevent but the ordinary case, measured to change no answer.

    The tiers are still real and they are about the BACKING STORE: InMemory/ is Tier A and Sqlite/
    is Tier B. What separates them now is which fixtures they build and which specification bases
    each can host, not which assembly they can see.

    TestUtilities/ IS THAT HARNESS, folded in by R137. It was InfoCarrier.Core.TestUtilities, a
    project of its own, and by R136 it had exactly one consumer: this one. Its stated reason was
    that the harness is "neither tier's property" and that nothing relational may be named in it,
    and one project makes the first moot and the second unenforceable by a boundary. What the
    folder still says is true and worth keeping: InfoCarrierTier and its InMemory subclass are
    store-neutral, and SqliteInfoCarrierTier is the per-store answer beside them.
  -->
  <PropertyGroup>
    <Description>Functional tests for InfoCarrier.Core against the ADR-009 backing stores: InMemory (Tier A), SQLite (Tier B) and Firebird (Tier C).</Description>
    <RootNamespace>InfoCarrier.Core.FunctionalTests</RootNamespace>
    <AssemblyName>InfoCarrier.Core.FunctionalTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Not a documented API, but the doc file is generated anyway: IDE0005 (unnecessary using) does
      not run without one. The doc-comment warnings that come with it (1254 in this repository) are
      switched off by the folder-scoped .editorconfig, not here.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CompiledModelTestBase compiles the model it scaffolds, in-process, against this assembly's
      own compilation references. Without this it cannot resolve `netstandard` and says so by
      name. Every EF test project that hosts this base sets it — InMemory, Sqlite, SqlServer,
      Cosmos and Design all do.
    -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The compiled-model baselines are *expected output*, not source: the same
      `TestNamespace.DbContextModel` is generated once per test, so compiling them gives 125
      duplicate-definition errors. EF's own InMemory and Sqlite test projects carry these two
      lines verbatim.
    -->
    <Compile Remove="InMemory\Scaffolding\Baselines\**\*" />
    <None Include="InMemory\Scaffolding\Baselines\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfoCarrier.Core\InfoCarrier.Core.csproj" />
    <!--
      The store-neutral half of TestUtilities/ moved out on 2026-09-13, because Tier D needs it too
      and cannot be in this project: it runs on a newer EF Core patch. What is left in
      TestUtilities/ here is the part that names a store — the three tiers and their backend
      stores, the Northwind contexts and the relational client shell.
    -->
    <ProjectReference Include="..\InfoCarrier.Core.TestUtilities\InfoCarrier.Core.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.NetTopologySuite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- ADR-009 Tier C. See Directory.Packages.props for why the engine arrives by package. -->
    <PackageReference Include="FirebirdSql.EntityFrameworkCore.Firebird" />
    <PackageReference Include="FirebirdDb.Embedded.NativeAssetManager" />
    <PackageReference Include="FirebirdDb.Embedded.V5.NativeAssets.Windows.X64" />
    <PackageReference Include="FirebirdDb.Embedded.V5.NativeAssets.Linux.X64" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Specification.Tests" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
