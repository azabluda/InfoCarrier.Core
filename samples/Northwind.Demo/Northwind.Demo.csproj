<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A console client for the InfoCarrier sample. Its DbContext has no database: every query, save and transaction crosses a real TCP socket to Northwind.Server.</Description>
    <RootNamespace>Northwind.Demo</RootNamespace>
    <AssemblyName>Northwind.Demo</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Not a documented API, but the doc file is generated anyway: IDE0005 (unnecessary using) does
      not run without one. The doc-comment warnings that come with it (1254 in this repository) are
      switched off by the folder-scoped .editorconfig, not here.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfoCarrier.Core\InfoCarrier.Core.csproj" />
    <ProjectReference Include="..\Northwind.Shared\Northwind.Shared.csproj" />
  </ItemGroup>

</Project>
