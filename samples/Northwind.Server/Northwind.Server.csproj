<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>The InfoCarrier sample server: SQLite behind an HTTP endpoint that speaks the envelope protocol.</Description>
    <RootNamespace>Northwind.Server</RootNamespace>
    <AssemblyName>Northwind.Server</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Not a documented API, but the doc file is generated anyway: IDE0005 (unnecessary using) does
      not run without one. The doc-comment warnings that come with it (1254 in this repository) are
      switched off by the folder-scoped .editorconfig, not here.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfoCarrier.Core\InfoCarrier.Core.csproj" />
    <ProjectReference Include="..\..\src\InfoCarrier.Core.AspNetCore\InfoCarrier.Core.AspNetCore.csproj" />
    <ProjectReference Include="..\Northwind.Shared\Northwind.Shared.csproj" />

    <!--
      The browser client, served from this host (spec §3.4): one process, one origin, no CORS and
      one launch profile. This is a hosting reference, not a code one: nothing in this project
      names a type from Northwind.Client.
    -->
    <ProjectReference Include="..\Northwind.Client\Northwind.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

    <!-- UseBlazorFrameworkFiles(), which maps _framework/* out of the referenced WASM project. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />

    <!--
      SQLitePCLRaw is unpinned repo-wide and resolves to 2.1.11 / SQLite 3.49.1, kept off the
      2.1.13 fix so four Northwind aggregate spec tests stay green on the pre-3.50
      CAST(real AS TEXT) formatting (full rationale in InfoCarrier.Core.FunctionalTests.csproj).
      2.1.11 carries GHSA-2m69-gcr7-jv3q; suppressed here because this is a sample, not a shipped
      or packaged artifact.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
