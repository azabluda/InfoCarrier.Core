@namespace Northwind.Client.Wire
@implements IDisposable
@inject WireLog Log

@*
    Native <details> rather than FluentAccordion: an accordion animates height, and twenty of them
    inside a scrolling panel that repaints on every round trip is more distracting than useful. A
    <details> opens instantly, keeps its own state, and costs no component.
*@

<div class="wire-head">
    <div class="wire-head-row">
        <span class="wire-title">📡 Wire</span>
        <span class="wire-count">@Log.Sequence round trip@(Log.Sequence == 1 ? "" : "s")</span>
        <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => Log.Clear())" Title="Clear the panel">
            Clear
        </FluentButton>
    </div>
    <div class="wire-hint">
        Every entry left this browser as an expression tree and came back as rows. Nested payloads
        are decoded, so the query itself is readable.
    </div>
</div>

<div class="wire-list">
    @if (Log.Entries.Count == 0)
    {
        <div class="wire-empty">💤 Nothing yet. Load a page, or ask for a navigation.</div>
    }

    @foreach (WireEntry entry in Log.Entries)
    {
        <details class="wire-entry">
            <summary>
                <span class="wire-seq">#@entry.Sequence</span>
                <span class="wire-op-tag @TagClass(entry)">@Emoji(entry) @entry.Operation</span>
                @if (entry.Fault is not null)
                {
                    <span class="wire-op">⚠️ fault</span>
                }
                <span class="wire-ms">@entry.Duration.TotalMilliseconds.ToString("F0") ms</span>
            </summary>

            <div class="wire-body">
                <div class="wire-meta">
                    <span>@entry.RequestBytes B out</span>
                    <span>@entry.ResponseBytes B in</span>
                </div>

                @if (entry.Fault is { } fault)
                {
                    <div class="wire-fault">@fault</div>
                }

                <div class="wire-label">Request</div>
                <pre class="wire-json">@entry.RequestPayload</pre>

                @if (entry.ResponsePayload.Length > 0)
                {
                    <div class="wire-label">Response</div>
                    <pre class="wire-json">@entry.ResponsePayload</pre>
                }
            </div>
        </details>
    }
</div>

@code {
    protected override void OnInitialized()
        => Log.Changed += OnChanged;

    public void Dispose()
        => Log.Changed -= OnChanged;

    // InvokeAsync, because the log is written from whichever continuation the transport completed
    // on rather than from an event handler Blazor already owns.
    private void OnChanged()
        => InvokeAsync(StateHasChanged);

    // Emoji rather than an icon package: one glyph per operation kind makes twenty rows scannable
    // at a glance, which is the panel's whole job.
    private static string Emoji(WireEntry entry)
        => entry.Operation switch
        {
            InfoCarrier.Core.Common.InfoCarrierOperation.Query => "🔍",
            InfoCarrier.Core.Common.InfoCarrierOperation.SaveChanges => "💾",
            InfoCarrier.Core.Common.InfoCarrierOperation.BeginTransaction => "🔓",
            InfoCarrier.Core.Common.InfoCarrierOperation.CommitTransaction => "✔️",
            InfoCarrier.Core.Common.InfoCarrierOperation.RollbackTransaction => "↩️",
            _ => "📍",
        };

    private static string TagClass(WireEntry entry)
        => entry.Operation switch
        {
            InfoCarrier.Core.Common.InfoCarrierOperation.SaveChanges => "op-save",
            InfoCarrier.Core.Common.InfoCarrierOperation.Query => "",
            _ => "op-tx",
        };
}
