<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>The InfoCarrier sample client: a Blazor WebAssembly app whose DbContext has no database. Every query, save and transaction crosses HTTP to Northwind.Server.</Description>
    <RootNamespace>Northwind.Client</RootNamespace>
    <AssemblyName>Northwind.Client</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Northwind.Client.Transport, not Northwind.Server. The browser must not depend on the server
      assembly, which is exactly why the transport was given a project of its own in Phase 1: it
      is a plain class library over System.Net.Http, which is what makes it WebAssembly-safe.
    -->
    <ProjectReference Include="..\Northwind.Client.Transport\Northwind.Client.Transport.csproj" />
    <ProjectReference Include="..\Northwind.Shared\Northwind.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />

    <!-- Program.cs uses this directly: AddSingleton, AddDbContextFactory. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
