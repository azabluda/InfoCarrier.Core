@page "/transfer"
@inject IDbContextFactory<NorthwindContext> Contexts
@inject WireLog Log

<PageTitle>Transfer</PageTitle>

<h1>🔄 A transaction, and a failure that travels</h1>

<p class="page-lede">
    Two saves inside one <code>BeginTransactionAsync</code>: move an order to another customer, and
    take one unit off a product's stock. Tick the box and the second save is given a customer id
    that does not exist, so the <em>server's</em> database refuses it. Either way the panel shows
    the whole shape &mdash; <code>BeginTransaction</code>, <code>SaveChanges</code>, then
    <code>Commit</code> or <code>Rollback</code>.
</p>

<div class="toolbar">
    <div class="field">
        @*
            A customer, not a primary key. The list offered `ALFKI`; nobody chooses a company that
            way. OptionValue keeps the id as the bound value -- it is what the foreign key needs --
            while OptionText is what a reader recognises.
        *@
        <FluentSelect TOption="CustomerOption" Items="@_customers"
                      OptionValue="@(c => c.Id)" OptionText="@(c => c.Company)"
                      @bind-Value="_target" Label="Move order 1 to" Style="min-width: 16rem;" />
    </div>
    <div class="field field-inline">
        <FluentCheckbox @bind-Value="_forceFailure" Label="Force a failure part-way" />
    </div>
    <FluentButton Appearance="Appearance.Accent" OnClick="TransferAsync" Disabled="@_running">Transfer</FluentButton>
    <span class="toolbar-spacer"></span>
    <span class="toolbar-note">@Log.Sequence round trips so far</span>
</div>

@if (_fault is { } fault)
{
    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false" Title="Rolled back">
        @fault
    </FluentMessageBar>
}
else if (_ok is { } ok)
{
    <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">@ok</FluentMessageBar>
}

<div class="card-row">
    <div class="card">
        <p class="card-title">🗄️ What the store holds now</p>

        <div class="kv">
            <span class="kv-key">Order 1 belongs to</span>
            <span class="kv-value">@(_actualCustomer ?? "…")</span>
        </div>
        <div class="kv">
            <span class="kv-key">Chai (product 1) units in stock</span>
            <span class="kv-value">@(_actualStock?.ToString() ?? "…")</span>
        </div>
    </div>

    <div class="card">
        <p class="card-title">🔎 Why this is trustworthy</p>
        <p class="page-note" style="margin-top: 0;">
            Both figures are read back through a <strong>freshly created context</strong> after every
            attempt, so they are the server's answer and not the local change tracker agreeing with
            itself. The exception below, when there is one, was raised on the server and rebuilt here
            from data in the response (wire-protocol W5) &mdash; a <code>SqliteException</code>
            cannot be reconstructed by a browser that has never heard of SQLite, so it arrives as its
            nearest public base, carrying the message rather than losing it.
        </p>
    </div>
</div>

@code {
    private const int OrderId = 1;
    private const int ProductId = 1;

    // Client-only, and split like every other row type on these pages: the server is asked for two
    // columns and the record is built here (ADR-010).
    private sealed record CustomerOption(string Id, string Company);

    // Read from the store rather than hard-coded, so the list cannot drift from the seed.
    private List<CustomerOption> _customers = [];

    private string _target = "ANATR";
    private bool _forceFailure;
    private bool _running;
    private string? _fault;
    private string? _ok;
    private string? _actualCustomer;
    private int? _actualStock;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using NorthwindContext context = await Contexts.CreateDbContextAsync();
            // All 65, ordered by the name they are shown under rather than by key. Two string
            // columns for 65 rows is nothing on the wire, and a dropdown that silently held the
            // first twelve keys was its own small dishonesty about what the store contains.
            _customers = await context.Customers
                .OrderBy(c => c.CompanyName)
                .Select(c => new CustomerOption(c.Id, c.CompanyName))
                .ToListAsync();
        }
        catch (Exception exception)
        {
            _fault = Describe(exception);
        }

        await ReadBackAsync();
    }

    private async Task TransferAsync()
    {
        _running = true;
        _fault = null;
        _ok = null;

        try
        {
            await using NorthwindContext context = await Contexts.CreateDbContextAsync();

            // The transaction is the client's, held open across several round trips on the server
            // side. Every operation below carries its id, which is what makes them one unit.
            await using IDbContextTransaction transaction = await context.Database.BeginTransactionAsync();

            try
            {
                Order order = await context.Orders.SingleAsync(o => o.Id == OrderId);
                Product product = await context.Products.SingleAsync(p => p.Id == ProductId);

                order.CustomerId = _target;
                product.UnitsInStock -= 1;
                await context.SaveChangesAsync();

                if (_forceFailure)
                {
                    // A customer id no row has. The client cannot know that; the *server's*
                    // database is what refuses it, which is the point -- the failure has to
                    // travel back as data and be raised again here (W5).
                    order.CustomerId = "ZZZZZ";
                    await context.SaveChangesAsync();
                }

                await transaction.CommitAsync();

                // No emoji in the text: FluentMessageBar draws its own icon for the intent, and a
                // second tick beside it reads as a mistake.
                _ok = $"Committed. Order {OrderId} now belongs to {_target}, and stock fell by one.";
            }
            catch (Exception exception)
            {
                await transaction.RollbackAsync();

                // Type first, then message, then the inner chain -- the three things W5 carries.
                // No stack trace on screen (spec §6); the panel holds the detail.
                _fault = Describe(exception);
            }
        }
        catch (Exception exception)
        {
            // Could not even open the transaction: a transport failure, not a server one.
            _fault = Describe(exception);
        }
        finally
        {
            _running = false;
            await ReadBackAsync();
        }
    }

    private async Task ReadBackAsync()
    {
        try
        {
            await using NorthwindContext context = await Contexts.CreateDbContextAsync();

            // AsNoTracking: this card claims to show the server's figures rather than the local
            // change tracker agreeing with itself, and a no-tracking read makes that structural.
            _actualCustomer = (await context.Orders.AsNoTracking().SingleAsync(o => o.Id == OrderId)).CustomerId;
            _actualStock = (await context.Products.AsNoTracking().SingleAsync(p => p.Id == ProductId)).UnitsInStock;
        }
        catch (Exception exception)
        {
            _fault ??= Describe(exception);
        }
    }

    private static string Describe(Exception exception)
    {
        var text = new System.Text.StringBuilder($"{exception.GetType().Name}: {exception.Message}");

        for (Exception? inner = exception.InnerException; inner is not null; inner = inner.InnerException)
        {
            text.Append($" ← {inner.GetType().Name}: {inner.Message}");
        }

        return text.ToString();
    }
}
