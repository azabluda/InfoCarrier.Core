@page "/order"
@* Named OrderPage, not Order: a component named Order would shadow Northwind.Shared.Model.Order inside its own markup, and every reference to the entity fails to compile. The route is unaffected. *@
@implements IAsyncDisposable
@inject IDbContextFactory<NorthwindContext> Contexts
@inject WireLog Log

<PageTitle>Order</PageTitle>

<h1>🧾 One order, one unit of work</h1>

<p class="page-lede">
    The query asks for an order and nothing else. Its <code>Customer</code> and its lines are
    <em>not</em> loaded until you ask for them, which costs a round trip each. Then edit as many
    quantities as you like and save: <strong>one</strong> <code>SaveChanges</code> carries all of
    them, because one context has been tracking them the whole time.
</p>

<p class="page-note">
    The loads here are <code>LoadAsync</code> rather than a bare <code>order.Customer</code>, and in
    a browser that is forced: a navigation getter is synchronous, so automatic lazy loading would
    have to block on the round trip, and a single-threaded WebAssembly runtime cannot block. This
    client therefore does not enable lazy-loading proxies at all, so an unloaded navigation is
    simply <code>null</code>. The server does enable them; it is not a browser.
</p>

<div class="toolbar">
    <div class="field">
        <FluentNumberField @bind-Value="_orderId" Label="Order id" Min="1" Max="5" Style="width: 7rem;" />
    </div>
    <FluentButton Appearance="Appearance.Accent" OnClick="LoadAsync">Load order</FluentButton>
    <span class="toolbar-spacer"></span>
    <span class="toolbar-note">@Log.Sequence round trips so far</span>
</div>

@if (_error is { } error)
{
    <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">@error</FluentMessageBar>
}

@if (_order is { } order)
{
    <div class="card-row">
        <div class="card">
            <p class="card-title">📋 Order @order.Id</p>

            <div class="kv">
                <span class="kv-key">Placed</span>
                <span class="kv-value">@order.OrderDate.ToString("yyyy-MM-dd")</span>
            </div>
            <div class="kv">
                <span class="kv-key">Customer id</span>
                <span class="kv-value">@order.CustomerId</span>
            </div>
            <div class="kv">
                <span class="kv-key">Customer</span>
                @if (_customerText is { } customerText)
                {
                    <span class="kv-value">@customerText</span>
                }
                else
                {
                    <FluentButton OnClick="TouchCustomer">not loaded &mdash; load it</FluentButton>
                }
            </div>
            <div class="kv">
                <span class="kv-key">Lines</span>
                @if (_lines is { } loaded)
                {
                    <span class="kv-value">@loaded.Count loaded</span>
                }
                else
                {
                    <FluentButton OnClick="TouchLines">not loaded &mdash; load them</FluentButton>
                }
            </div>
        </div>

        @if (_lines is { } lines)
        {
            <div class="card">
                <p class="card-title">✏️ Lines &mdash; edit any quantity</p>

                @foreach (OrderDetail line in lines)
                {
                    <div class="kv">
                        <span class="kv-key">product @line.ProductId &nbsp;&middot;&nbsp; @line.UnitPrice.ToString("0.00")</span>
                        <FluentNumberField Value="@line.Quantity" Min="0" Style="width: 6.5rem;"
                                           ValueChanged="@(value => SetQuantity(line, value))"
                                           TValue="int" Immediate="true" />
                    </div>
                }

                <div class="actions">
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(_pending == 0)" OnClick="SaveAsync">
                        Save @_pending change@(_pending == 1 ? "" : "s")
                    </FluentButton>
                    <span class="toolbar-note">
                        @if (_saved is { } saved)
                        {
                            @($"Last save: {saved} entries, in 1 SaveChanges envelope.")
                        }
                        else
                        {
                            @("The button counts what the change tracker is holding.")
                        }
                    </span>
                </div>
            </div>
        }
    </div>

    <p class="page-note">
        Loading the order was one round trip. Loading the customer was one more, the lines one more
        &mdash; and saving is one, however many quantities changed.
    </p>
}

@code {
    private NorthwindContext? _context;
    private Order? _order;
    private List<OrderDetail>? _lines;
    private string? _customerText;
    private int _orderId = 1;
    private int _pending;
    private int? _saved;
    private string? _error;

    // **One context for this page, unlike Customers, and here it is the point rather than a
    // habit.** The unit of work IS the demonstration: several edits accumulate in one change
    // tracker and leave as one SaveChanges. Safe to hold because every operation below is started
    // by a button — there is no provider polling it, which is exactly what made a page-scoped
    // context wrong on Customers.
    protected override async Task OnInitializedAsync()
        // Loads order 1 straight away. A page that shows nothing until a button is pressed hides
        // the very thing it is here to show, and the lazy-loading point is unaffected: the
        // navigations are still untouched afterwards.
        => await LoadAsync();

    private async Task LoadAsync()
    {
        // A fresh context per load, so a second "Load order" does not inherit the last one's
        // tracked edits — that would make the pending count a lie.
        if (_context is not null)
        {
            await _context.DisposeAsync();
        }

        _context = await Contexts.CreateDbContextAsync();

        _order = null;
        _lines = null;
        _customerText = null;
        _pending = 0;
        _saved = null;

        await Guard(async () =>
        {
            // No Include, and that is the whole point: what comes back is one order.
            _order = await _context.Orders.SingleOrDefaultAsync(o => o.Id == _orderId);

            if (_order is null)
            {
                _error = $"No order with id {_orderId}.";
            }
        });
    }

    // ---------------------------------------------------------------------------------------
    // **Explicit async loading, and in a browser it is not a style choice.**
    //
    // Reading `_order.Customer` would be the prettier demo, and with lazy-loading proxies on a
    // desktop client that is exactly what you would write. It cannot work here: a property getter
    // is synchronous, so the load has to BLOCK on the HTTP round trip, and a single-threaded
    // WebAssembly runtime cannot block. With proxies enabled it failed with
    // `PlatformNotSupportedException: Cannot wait on monitors on this runtime` *after* the request
    // had already gone out -- the panel showed the round trip and the value never arrived.
    // `ILazyLoader.Load()` is synchronous too, so injecting a loader instead fails identically.
    //
    // Program.cs therefore does not enable proxies on the client at all, which turns that
    // confusing failure into a plain `null`. `LoadAsync` is the same lazy load with the await made
    // visible: the navigation is still not fetched by the original query, and asking for it still
    // costs exactly one round trip -- which is the point this page exists to make.
    // ---------------------------------------------------------------------------------------
    private async Task TouchCustomer()
        => await Guard(async () =>
        {
            await _context!.Entry(_order!).Reference(o => o.Customer).LoadAsync();

            Customer? customer = _order!.Customer;
            _customerText = customer is null ? "(none)" : $"{customer.CompanyName} — {customer.City}";
        });

    private async Task TouchLines()
        => await Guard(async () =>
        {
            await _context!.Entry(_order!).Collection(o => o.OrderDetails).LoadAsync();
            _lines = [.. _order!.OrderDetails];
        });

    private void SetQuantity(OrderDetail line, int quantity)
    {
        line.Quantity = quantity;

        // Read off the change tracker rather than counted by hand: it is the same number
        // SaveChanges is about to act on, and setting a value back to its original removes it
        // again — which a hand-rolled counter would get wrong.
        _pending = _context!.ChangeTracker.Entries().Count(e => e.State == EntityState.Modified);
        _saved = null;
    }

    private async Task SaveAsync()
        => await Guard(async () =>
        {
            _saved = await _context!.SaveChangesAsync();
            _pending = _context.ChangeTracker.Entries().Count(e => e.State == EntityState.Modified);
        });

    private async Task Guard(Func<Task> action)
    {
        try
        {
            _error = null;
            await action();
        }
        catch (Exception exception)
        {
            // Visible, never swallowed (spec §6). The panel on the right carries the detail.
            _error = $"{exception.GetType().Name}: {exception.Message}";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_context is not null)
        {
            await _context.DisposeAsync();
        }
    }
}
