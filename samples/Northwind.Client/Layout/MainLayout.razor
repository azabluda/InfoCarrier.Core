@inherits LayoutComponentBase

@*
    The shell is a CSS grid rather than nested FluentStacks. Three regions that must hold their
    proportions independently -- nav rail, content, docked inspector -- are what grid is for, and
    a grid cannot collapse into block flow the way stacked flex containers can.

    Emoji rather than FluentIcon: Fluent UI ships its icon set as a separate, large package, and a
    sample about the wire should not pull one in to decorate a nav menu. Emoji cost nothing.
*@

<FluentDesignTheme Mode="DesignThemeModes.System" StorageName="infocarrier-theme" />

<div class="app-shell">
    <header class="app-header">
        <span class="app-mark">InfoCarrier<span class="app-mark-dim">.Core</span></span>
        <span class="app-sep">/</span>
        <span class="app-title">Northwind</span>
        <span class="app-badge">🚫🗄️ this browser has no database</span>
    </header>

    <nav class="app-nav">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-label">👥 Customers</span>
            <span class="nav-hint">querying</span>
        </NavLink>
        <NavLink class="nav-item" href="order">
            <span class="nav-label">🧾 Order</span>
            <span class="nav-hint">loading &amp; unit of work</span>
        </NavLink>
        <NavLink class="nav-item" href="transfer">
            <span class="nav-label">🔄 Transfer</span>
            <span class="nav-hint">transactions &amp; errors</span>
        </NavLink>

        @*
            The wordmark as TEXT, not as the hexagon badge. The badge is drawn to be legible
            at 128px on a package listing; shrunk into a nav rail it is a blue smudge at 20px
            and merely small at 40px. The README banner's mock UI sets "ic.c" here as plain
            lettering, and text is the one thing that stays crisp at any size the rail gives
            it -- no image, no reflow, and it follows the theme's own accent colour.
        *@
        <div class="app-brand">
            <span class="app-brand-text">ic.<span class="app-brand-accent">c</span></span>
        </div>
    </nav>

    <main class="app-main">
        @Body
    </main>

    @* Docked right, full height, its own scroll (spec §5.2). *@
    <aside class="app-wire">
        <WireInspector />
    </aside>
</div>
