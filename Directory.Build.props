<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Runs the IDE#### code-style analyzers as part of the build instead of only in an editor, so
      CI sees them. Which of them are on is decided in .editorconfig, where all but IDE0005
      (unnecessary using directive) are switched off.
    -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Company>InfoCarrier.Core</Company>
    <Product>InfoCarrier.Core</Product>
    <Description>Entity Framework Core database provider that remotes LINQ queries and change-tracking over a wire protocol.</Description>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Package identity. Applies to every project, which is why IsPackable is FALSE here: `dotnet
    pack` on the solution would otherwise produce a package for each sample and each test project.
    The two products under src/ opt in individually.
  -->
  <PropertyGroup Label="Package identity">
    <IsPackable>false</IsPackable>

    <!--
      10.0.0 matches Entity Framework Core's major, which is the convention every EF provider
      follows and the fastest way for a reader to know which EF this targets.

      `-preview.1` is deliberate and should stay until M8's exit criteria are met. Nine
      limitations are known and written up in docs/limitations.md, there is no gRPC binding, and
      results do not stream yet — and the last two may touch IInfoCarrierTransport. A stable
      10.0.0 is a promise not to break that surface, and this is not the moment to make it.
    -->
    <VersionPrefix>10.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>

    <Authors>Alexander Zabluda</Authors>
    <Copyright>Copyright (c) Alexander Zabluda</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/azabluda/InfoCarrier.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/azabluda/InfoCarrier.Core.git</RepositoryUrl>
    <PackageTags>entity-framework-core;efcore;ef-core-provider;linq;n-tier;multi-tier;blazor;wpf;expression-trees;change-tracking</PackageTags>

    <!--
      The package README is docs/nuget-readme.md rather than the repository README, and the reason
      is mechanical: nuget.org renders a README but resolves images only against ABSOLUTE URLs, so
      the banner the repository README opens with would show as a broken image. The repository
      README also links to a dozen relative docs paths that mean nothing inside a package.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A separate .snupkg, which is what nuget.org's symbol server accepts. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink: step into this package's source from a debugger. Built into the SDK. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <PropertyGroup Label="Signing">
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>
</Project>
